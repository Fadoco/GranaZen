{
  "name": "granazen",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/GranaZen/ --outDir docs",
    "build:android": "npm run build && npx cap sync android && cd apk && gradlew.bat assembleDebug",
    "build:android:release": "npm run build && npx cap sync android && cd apk && gradlew.bat assembleRelease",
    "sync:android": "npm run build && npx cap sync android",
    "open:android": "npx cap open android",
    "test:finance": "node --test scripts/finance-utils.test.mjs scripts/statement-import.test.mjs scripts/financial-report.test.mjs",
    "test:release-version": "node --test scripts/check-android-release-version.test.mjs scripts/prepare-android-release.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.0.0",
    "lucide-react": "^1.46.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
